{
  "name": "weekly-penguin-timeline",
  "version": "0.1.0-alpha.1",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "assets:validate": "node scripts/penguin-assets.mjs",
    "assets:generate": "node scripts/penguin-assets.mjs --generate",
    "assets:generate:force": "node scripts/penguin-assets.mjs --generate --force",
    "predev": "npm run assets:generate",
    "dev": "next dev",
    "prebuild": "npm run assets:generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run assets:validate && npm run lint && npm run typecheck && npm run test",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "sharp": "^0.35.5",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
